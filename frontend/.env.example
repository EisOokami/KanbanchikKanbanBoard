# ─── API ──────────────────────────────────────────────────────────────────────
# API address used by the Next.js server (server actions, loaders).
API_URL=http://localhost:3001
# API address used by the browser (Google sign-in link, attachment previews).
NEXT_PUBLIC_API_URL=http://localhost:3001
# API address the file links contain when the API is reached internally (e.g. in
# Docker); attachment previews replace it with NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_INTERNAL_API_URL=http://localhost:3001

# ─── Client IP behind a reverse proxy ─────────────────────────────────────────
# Header with the real client IP set by the proxy in front of Next.js (e.g.
# x-real-ip). Forwarded to the API for rate limits. Leave empty without a proxy.
CLIENT_IP_HEADER=

# ─── Content Security Policy ──────────────────────────────────────────────────
# Extra allowed sources, space or comma separated (e.g. the API origin for
# images). Google profile photos and cdn.jsdelivr.net are always allowed.
INTERNAL_IMG_SRC_URL=http://localhost:3001
INTERNAL_CONNECT_SRC_URL=

# ─── Image optimization (next/image) ──────────────────────────────────────────
# Where uploaded images are served from.
API_PROTOCOL=http
API_HOSTNAME=localhost
API_PORT=3001
# A second allowed image source.
ADDITIONAL_PROTOCOL=http
ADDITIONAL_HOSTNAME=127.0.0.1
ADDITIONAL_PORT=3001

# ─── Legal documents (/privacy, /terms) ───────────────────────────────────────
# Public address of the service shown in the documents.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Versions shown on the pages; keep them equal to the API values.
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0
# Dates shown in the documents, e.g. "20 listopada 2026 r.".
LEGAL_LAST_TERMS_UPDATED=
LEGAL_EFFECTIVE_TERMS_DATE=
LEGAL_LAST_PRIVACY_UPDATED=
LEGAL_EFFECTIVE_PRIVACY_DATE=
# Operator (data controller) and contact e-mail.
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=
# Server provider and country, e.g. "Hetzner Online GmbH (Niemcy)".
LEGAL_SERVER_PROVIDER=
# Backup retention, e.g. "do 30 dni".
LEGAL_BACKUP_RETENTION=
# Repository and license links (default: this repository on GitHub).
LEGAL_REPOSITORY_URL=
LEGAL_LICENSE_URL=
# Empty values show a highlighted [DO UZUPEŁNIENIA] placeholder on the pages.
