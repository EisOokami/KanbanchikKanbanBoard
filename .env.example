# Root .env for `docker compose up` (docker-compose.yml reads only this file).
# Put here every variable from backend/.env.example and frontend/.env.example
# (they are passed to the containers), plus the Docker-only values below.
# In Docker use DB_HOST=mariadb and LOG_FILE=/var/logs/app/app.log.

# ─── MariaDB container ────────────────────────────────────────────────────────
# Root password of the database container (MARIADB_ROOT_PASSWORD).
DB_ROOT_PASSWORD=

# ─── Grafana (published on 127.0.0.1:3200 only) ───────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# true lets anyone create a Grafana account; keep false.
GRAFANA_ALLOW_SIGN_UP=false
# Optional comma-separated Grafana plugins to install.
GRAFANA_INSTALL_PLUGINS=

# ─── Frontend (passed by docker-compose, not used by the code) ────────────────
# Legacy: session cookies are host-only now.
HOST=
