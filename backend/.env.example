# ─── Runtime ──────────────────────────────────────────────────────────────────
# development | production (production enables secure cookies).
NODE_ENV=development
# Port of the API.
PORT=3001

# ─── Database (MariaDB) ───────────────────────────────────────────────────────
# backend/database/database.sql creates the kanbanchik_board database.
# In Docker use the service name as host: DB_HOST=mariadb.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kanbanchik_board
DB_USER=
DB_PASSWORD=

# ─── Secrets (generate long random values, e.g. `openssl rand -base64 48`) ────
# Sign access and refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Signs CSRF tokens.
CSRF_SECRET=
# Encrypts stored 2FA secrets; at least 32 characters.
MFA_ENCRYPTION_KEY=
# Sign the e-mail codes for login, account deletion and ownership transfer.
LOGIN_CODE_SECRET=
DELETION_CODE_SECRET=
TRANSFER_CODE_SECRET=
# Signs the expiring links to uploaded files (defaults to JWT_ACCESS_SECRET).
FILE_URL_SECRET=
# Lifetime of file links in hours (default 24, max 168).
FILE_URL_TTL_HOURS=

# ─── URLs, CORS and hosts ─────────────────────────────────────────────────────
# Public URLs of both apps, used in e-mails, redirects and file links.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
# Comma-separated allowed origins and host names (with port).
CORS_URLS=http://localhost:3000
HOSTS=localhost:3001
# Trusted proxies in front of the API: addresses or subnets (comma-separated,
# e.g. `loopback,172.18.0.0/16`) or a number of hops. Empty = X-Forwarded-For
# is ignored. `true` is treated as one hop.
TRUST_PROXY=

# ─── Legal documents ──────────────────────────────────────────────────────────
# Required. Versions of the Terms of Service and Privacy Policy (/terms, /privacy).
# After a bump every account has to accept the new versions. Keep them equal to
# the frontend values.
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0
# Data controller named in invitation e-mails (defaults: the operator from the
# Privacy Policy).
LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=

# ─── E-mail (Nodemailer) ──────────────────────────────────────────────────────
# Nodemailer well-known service (e.g. gmail) and the sender mailbox.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# ─── Google sign-in ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# <API URL>/auth/google/callback, registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ─── AI ───────────────────────────────────────────────────────────────────────
# Gemini model (default gemini-3.5-flash-lite). There is no server key: each user
# adds their own Gemini API key in Account settings → AI.
GEMINI_MODEL=

# ─── Invitations and retention ────────────────────────────────────────────────
# Invitation e-mails one user can send per 24 hours (default 50).
MAX_INVITES_PER_DAY=
# false disables the hourly clean-up of expired invitations, sessions, codes and
# never-verified accounts.
RETENTION_CLEANUP=

# ─── Logs ─────────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error (default info).
LOG_LEVEL=info
# Optional log file; one file per day (app-YYYY-MM-DD.log). Empty = stdout.
# In Docker: /var/logs/app/app.log (read by Promtail for Grafana).
LOG_FILE=
# Days to keep log files (default 30).
LOG_RETENTION_DAYS=
